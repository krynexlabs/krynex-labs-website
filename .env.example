# Krynex Labs — Environment Configuration Template
# Copy this file to .env.local for local development.
# In production, set these in Vercel: Project → Settings → Environment Variables.
# NEVER commit real values. .env* files are git-ignored (except this template).

# --- Contact form email delivery (server-side only, via Resend) ---
# All three are REQUIRED in production. If any is missing, the contact form
# returns a 503 "temporarily unavailable" error instead of pretending to send.
# (In local development only, a missing config just logs the inquiry to the terminal.)
RESEND_API_KEY=
# Mailbox that receives inquiries (official support & public business address).
CONTACT_EMAIL_RECIPIENT=support@krynexlabs.in
# Sender address on a domain you have VERIFIED in Resend (e.g. noreply@your-domain).
CONTACT_FROM_EMAIL=

# Note: the canonical site URL (https://www.krynexlabs.in) is defined in
# src/data/site-data.ts. No site-URL environment variable is needed.
