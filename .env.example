# ==============================================================================
# Krynex Labs Enterprise Web Application — Environment Configuration Template
# ==============================================================================
# All private keys and credentials must be configured in .env.local (development)
# or via the Vercel Project Settings > Environment Variables portal (production).
# DO NOT commit real secrets or production credentials to this file or Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Inbound Inquiry Email Delivery Service (Resend)
# ------------------------------------------------------------------------------
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# The operational inbox that receives client briefing dockets
CONTACT_RECEIVER_EMAIL=support@krynexlabs.in

# Outbound sender identity (e.g. Krynex Labs <support@krynexlabs.in>)
# For unverified domains during testing, use "onboarding@resend.dev"
CONTACT_FROM_EMAIL=Krynex Labs Briefing <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 2. Secondary Fallback SMTP Transport (Optional)
# ------------------------------------------------------------------------------
# If Resend is unavailable or rate-limited, the application can route through SMTP
# GMAIL_USER=support@krynexlabs.in
# GMAIL_APP_PASSWORD=your_16_char_app_password_here
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
